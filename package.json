{
  "name": "@yungsnat/grievousgreps",
  "private": true,
  "version": "0.28.0+gg",
  "description": "A distribution of Trail-Code: a code graph for coding agents, with caller recall measured on public repositories.",
  "keywords": [
    "ai",
    "agents",
    "knowledge-graph",
    "context",
    "codebase",
    "llm",
    "graft"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yungSNAT/GrievousGreps.git"
  },
  "homepage": "https://github.com/yungSNAT/GrievousGreps#readme",
  "bugs": {
    "url": "https://github.com/yungSNAT/GrievousGreps/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "trail": "dist/bin/trail.js",
    "graft": "dist/bin/graft.js"
  },
  "files": [
    "dist",
    "models",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p viewer/tsconfig.json && node scripts/build-viewer.mjs && node scripts/vendor-grammars.mjs && node scripts/stamp-commit.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "cli": "tsx src/cli.ts",
    "test": "node scripts/run-tests.mjs",
    "prepare": "npm run build && node scripts/stamp-telemetry-key.mjs",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "engines": {
    "node": ">=22.3.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "openai": "^7.60.0",
    "smol-toml": "^1.9.1",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.18.2",
    "web-tree-sitter": "^0.27.2",
    "web-tree-sitter-depth": "npm:web-tree-sitter@0.22.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.1.0",
    "c8": "^12.0.0",
    "d3-force": "^3.0.0",
    "esbuild": "^0.28.1",
    "fast-check": "^4.10.3",
    "node-gyp": "^12.4.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-php": "^0.23.4",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-r": "npm:@davisvaughan/tree-sitter-r@^1.3.0",
    "tree-sitter-swift": "^0.7.1",
    "tree-sitter-typescript": "^0.23.2",
    "tree-sitter-wasm": "^2.0.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "tree-sitter@0.21.1": true,
    "tree-sitter-typescript@0.23.2": true,
    "tree-sitter-python@0.21.0": true,
    "tree-sitter-go@0.23.4": true,
    "tree-sitter-javascript@0.23.1": true,
    "tree-sitter-java@0.23.5": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "tree-sitter-kotlin@0.3.8": true,
    "tree-sitter-php@0.23.12": true,
    "@davisvaughan/tree-sitter-r@1.3.0": true,
    "tree-sitter-swift@0.7.1": true
  },
  "overrides": {
    "test-exclude": {
      "glob": "^14.0.6",
      "minimatch": "^11.0.9"
    },
    "tree-sitter-swift": {
      "tree-sitter": "$tree-sitter"
    },
    "js-yaml": {
      "argparse": "^2.0.1"
    }
  }
}
